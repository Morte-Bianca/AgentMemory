{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    { "src": "/health", "dest": "/api/health" },
    { "src": "/v1/(.*)", "dest": "/api/v1?path=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
