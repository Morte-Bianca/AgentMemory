# For local MCP usage, prefer 127.0.0.1 unless you explicitly need remote access.
HOST=0.0.0.0
PORT=3000
DEFAULT_DREAM_INTERVAL_MS=900000
EMBEDDING_DIMENSIONS=128
DREAM_PROVIDER=local
MCP_SESSION_EVENT_LIMIT=100
MCP_SESSION_TTL_MS=86400000
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage driver: file | postgres
STORAGE_DRIVER=file
DATA_FILE_PATH=./data/store.json

# Required when STORAGE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentmemory
