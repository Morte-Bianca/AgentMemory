# For local MCP usage, prefer 127.0.0.1 unless you explicitly need remote access.
HOST=0.0.0.0
PORT=3000
DEFAULT_DREAM_INTERVAL_MS=900000
EMBEDDING_DIMENSIONS=128
DREAM_PROVIDER=local

# Auth
# Default: TEST_MODE=false (API key required for protected endpoints).
# For public testing only: set TEST_MODE=true (anonymous access uses a shared public agent).
TEST_MODE=false
ALLOW_OPEN_AGENT_CREATE=false
GOOGLE_CLIENT_ID=1089321830084-59ar66h9k2squ63vfc7nqjs9pa3q55n5.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=1089321830084-59ar66h9k2squ63vfc7nqjs9pa3q55n5.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=1089321830084-59ar66h9k2squ63vfc7nqjs9pa3q55n5.apps.googleusercontent.com
AUTH_SESSION_SECRET=am_v1_Y7rN3pQ8xL2mK9sD4uH6wF1cJ5tV0bZqR8nE3yP6gA2kM4xT7hC9sL1dW5
MCP_SESSION_EVENT_LIMIT=100
MCP_SESSION_TTL_MS=86400000
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage driver: file | postgres
STORAGE_DRIVER=file
DATA_FILE_PATH=./data/store.json

# Required when STORAGE_DRIVER=postgres
# You can also use Vercel Postgres variables like POSTGRES_URL (the app will auto-detect them).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentmemory

# -----------------------------------------------------------------------------
# Memory commitments: Encrypted content + CID (Pinata/IPFS) + on-chain commits
# -----------------------------------------------------------------------------
# Default: disabled.
MEMORY_COMMITMENTS_ENABLED=false

# Encryption key for encrypting the blob we upload to IPFS (AES-256-GCM).
# Must be 32 bytes, base64-encoded. Example generation:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEMORY_ENCRYPTION_KEY_BASE64=

# Storage provider
MEMORY_COMMITMENTS_STORAGE_PROVIDER=pinata

# Pinata auth (use either JWT OR apiKey+apiSecret)
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# Optional Pinata metadata
PINATA_PIN_NAME_PREFIX=agentmemory
PINATA_PIN_GROUP_ID=

# Optional: gateway base URL used for verification fetches.
# Defaults to https://gateway.pinata.cloud/ipfs/
IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs/

# EVM commit settings (0-value tx with data payload: hash + cid + memoryId)
MEMORY_COMMITMENTS_EVM_ENABLED=false
EVM_RPC_URL=
EVM_CHAIN_ID=
EVM_PRIVATE_KEY=
# Contract registry address. If set, commits go through this contract.
EVM_CONTRACT_ADDRESS=
# Optional override (legacy tx-data mode only); default is the wallet's own address.
EVM_TO_ADDRESS=

# Solana commit settings (Memo program with a compact payload)
MEMORY_COMMITMENTS_SOLANA_ENABLED=false
SOLANA_RPC_URL=
# Commitment program id. If set, commits go through this program.
SOLANA_PROGRAM_ID=
# Secret key as JSON array (Solana CLI format), e.g. "[12,34,...]"
SOLANA_SECRET_KEY=
